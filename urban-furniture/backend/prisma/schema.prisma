// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================
// EXISTING AUTH ENUMS & MODELS (PRESERVED)
// ==============================================

enum Role {
  ADMIN
  ACCOUNTANT
  CUSTOMER
}

enum AccountantType {
  SALES
  PURCHASE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  DISABLED
  PENDING_VERIFICATION
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         Role
  status       UserStatus @default(ACTIVE)
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  accountant Accountant?
  customer   Customer?
  invitation Invitation?
  otps       Otp[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Accountant {
  id             String         @id @default(uuid())
  userId         String         @unique
  accountantCode String         @unique
  employeeId     String         @unique
  mobile         String
  department     String
  accountantType AccountantType
  permissions    String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountantCode])
  @@index([employeeId])
  @@index([accountantType])
  @@map("accountants")
}

model Customer {
  id           String   @id @default(uuid())
  userId       String   @unique
  customerCode String   @unique
  mobile       String
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerCode])
  @@map("customers")
}

model Invitation {
  id         String    @id @default(uuid())
  userId     String    @unique
  tokenHash  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Otp {
  id         String    @id @default(uuid())
  userId     String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otps")
}

// ==============================================
// ERP BUSINESS ENUMS
// ==============================================

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum AccountType {
  ASSET
  LIABILITY
  CAPITAL
  INCOME
  EXPENSE
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
  GENERAL
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  BILLED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentType {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  BANK
}

// ==============================================
// ERP MASTER DATA MODELS
// ==============================================

model Contact {
  id        String      @id @default(uuid())
  name      String
  type      ContactType @default(CUSTOMER)
  email     String?
  mobile    String?
  city      String?
  state     String?
  pincode   String?
  imageUrl  String?
  status    String      @default("ACTIVE")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  salesOrders      SalesOrder[]      @relation("CustomerSalesOrders")
  customerInvoices CustomerInvoice[] @relation("CustomerInvoices")
  purchaseOrders   PurchaseOrder[]   @relation("VendorPurchaseOrders")
  vendorBills      VendorBill[]      @relation("VendorBills")
  payments         Payment[]

  @@map("contacts")
}

model Product {
  id         String      @id @default(uuid())
  name       String
  type       ProductType @default(GOODS)
  category   String      @default("Furniture")
  salesPrice Float       @default(0)
  costPrice  Float       @default(0)
  status     String      @default("ACTIVE")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  salesOrderItems     SalesOrderItem[]
  customerInvoiceItems CustomerInvoiceItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  vendorBillItems     VendorBillItem[]

  @@map("products")
}

model Account {
  id        String      @id @default(uuid())
  code      String      @unique
  name        String
  type        AccountType
  description String?
  status      String      @default("ACTIVE")
  balance     Float       @default(0)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  defaultJournals Journal[]     @relation("DefaultJournalAccount")
  journalItems    JournalItem[]

  @@map("accounts")
}

model Journal {
  id               String      @id @default(uuid())
  code             String      @unique
  name             String
  type             JournalType
  defaultAccountId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  defaultAccount Account?       @relation("DefaultJournalAccount", fields: [defaultAccountId], references: [id])
  journalEntries JournalEntry[]

  @@map("journals")
}

model JournalEntry {
  id          String   @id @default(uuid())
  entryNumber String   @unique
  journalId   String
  date        DateTime @default(now())
  reference   String?
  status      String   @default("POSTED") // POSTED, DRAFT
  totalDebit  Float    @default(0)
  totalCredit Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journal Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  items   JournalItem[]

  @@map("journal_entries")
}

model JournalItem {
  id        String  @id @default(uuid())
  entryId   String
  accountId String
  label     String?
  debit     Float   @default(0)
  credit    Float   @default(0)

  // Relations
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@map("journal_items")
}

// ==============================================
// SALES & PURCHASE TRANSACTIONS
// ==============================================

model SalesOrder {
  id          String           @id @default(uuid())
  orderNumber String           @unique
  customerId  String?
  date        DateTime         @default(now())
  subtotal    Float            @default(0)
  tax         Float            @default(0)
  total       Float            @default(0)
  status      SalesOrderStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  customer Contact?         @relation("CustomerSalesOrders", fields: [customerId], references: [id])
  items    SalesOrderItem[]
  invoices CustomerInvoice[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  taxRate     Float    @default(0)
  total       Float    @default(0)

  // Relations
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

model CustomerInvoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  salesOrderId   String?
  customerId     String?
  customerUserId String?       // Allows linking to Customer User login
  customerEmail  String?       // Fallback link by email for customer portal
  date           DateTime      @default(now())
  dueDate        DateTime?
  subtotal       Float         @default(0)
  tax            Float         @default(0)
  total          Float         @default(0)
  paidAmount     Float         @default(0)
  status         InvoiceStatus @default(UNPAID)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  salesOrder SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  customer   Contact?              @relation("CustomerInvoices", fields: [customerId], references: [id])
  items      CustomerInvoiceItem[]
  payments   Payment[]

  @@map("customer_invoices")
}

model CustomerInvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  taxRate     Float    @default(0)
  total       Float    @default(0)

  // Relations
  invoice CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@map("customer_invoice_items")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  orderNumber String              @unique
  vendorId    String?
  date        DateTime            @default(now())
  subtotal    Float               @default(0)
  tax         Float               @default(0)
  total       Float               @default(0)
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  vendor Contact?            @relation("VendorPurchaseOrders", fields: [vendorId], references: [id])
  items  PurchaseOrderItem[]
  bills  VendorBill[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  taxRate     Float    @default(0)
  total       Float    @default(0)

  // Relations
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model VendorBill {
  id              String     @id @default(uuid())
  billNumber      String     @unique
  purchaseOrderId String?
  vendorId        String?
  date            DateTime   @default(now())
  dueDate         DateTime?
  subtotal        Float      @default(0)
  tax             Float      @default(0)
  total           Float      @default(0)
  paidAmount      Float      @default(0)
  status          BillStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  vendor        Contact?         @relation("VendorBills", fields: [vendorId], references: [id])
  items         VendorBillItem[]
  payments      Payment[]

  @@map("vendor_bills")
}

model VendorBillItem {
  id          String   @id @default(uuid())
  billId      String
  productId   String?
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  taxRate     Float    @default(0)
  total       Float    @default(0)

  // Relations
  bill    VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@map("vendor_bill_items")
}

model Payment {
  id                String        @id @default(uuid())
  paymentNumber     String        @unique
  paymentType       PaymentType   // INBOUND, OUTBOUND
  method            PaymentMethod @default(BANK) // CASH, BANK
  amount            Float
  date              DateTime      @default(now())
  reference         String?
  notes             String?
  contactId         String?
  customerInvoiceId String?
  vendorBillId      String?
  journalEntryId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  contact         Contact?         @relation(fields: [contactId], references: [id])
  customerInvoice CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])
  vendorBill      VendorBill?      @relation(fields: [vendorBillId], references: [id])

  @@map("payments")
}

// ==============================================
// ANALYTICS & BUDGETS
// ==============================================

model AnalyticAccount {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  type        String   // Income, Expenses
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  budgets Budget[]

  @@map("analytic_accounts")
}

model Budget {
  id                String           @id @default(uuid())
  name              String
  period            String           // e.g., "Q1 2026", "2026"
  plannedAmount     Float            @default(0)
  responsible       String?
  status            String           @default("ACTIVE")
  analyticAccountId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  analyticAccount AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])

  @@map("budgets")
}
